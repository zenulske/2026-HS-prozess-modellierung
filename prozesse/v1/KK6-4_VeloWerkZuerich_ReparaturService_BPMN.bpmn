    <bpmn:textAnnotation id="T01" textFormat="text/plain">
      <bpmn:text>SP1 liefert die aktuelle Freigabe.
Ja: E17.
Nein: A33 / E18 mit Grund.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T02" textFormat="text/plain">
      <bpmn:text>SP2 meldet die Prüfbereitschaft.
Ja: E20. Nein: A34 / E21.
Ohne SP2 gilt: nicht prüfbereit.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="T03" textFormat="text/plain">
      <bpmn:text>SP3 meldet den Abschluss.
A27 / E23: vollständig.
A32 / E24: unvollständig.
G15 verwendet diesen Status.</bpmn:text>
    </bpmn:textAnnotation>
