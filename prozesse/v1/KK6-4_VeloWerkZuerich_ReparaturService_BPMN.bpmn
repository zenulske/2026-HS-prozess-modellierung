<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_KK64_v3" targetNamespace="https://example.org/velowerk/KK6-4/K4/v3" exporter="KK6-4 BPMN XML authoring" exporterVersion="3.0">
  <bpmn:message id="Msg_M01" name="Werkstattanfrage"/>
  <bpmn:message id="Msg_M02" name="Vorschlag"/>
  <bpmn:message id="Msg_M03" name="Kundenentscheid"/>
  <bpmn:message id="Msg_M04" name="Teilebedarf"/>
  <bpmn:message id="Msg_M05" name="Bereitstellungsstatus"/>
  <bpmn:message id="Msg_M06" name="Lieferoption"/>
  <bpmn:message id="Msg_M07" name="Lieferentscheid"/>
  <bpmn:message id="Msg_M08" name="Bereitstellungsbestätigung"/>
  <bpmn:message id="Msg_M09" name="Zusatzvorschlag"/>
  <bpmn:message id="Msg_M10" name="Zusatzentscheid"/>
  <bpmn:message id="Msg_M11" name="Abholinformation"/>
  <bpmn:message id="Msg_M12" name="Leistungsdaten"/>
  <bpmn:message id="Msg_M13" name="Abbruchinformation"/>
  <bpmn:message id="Msg_M14" name="Erbrachte Leistungen"/>
  <bpmn:message id="Msg_M15" name="Abbruch / Restteile"/>
  <bpmn:process id="Process_K4" name="K4 Reparatur- und Serviceaufträge abwickeln" isExecutable="false">
    <bpmn:documentation>Fiktives fachliches Modell K4-A-3.0 / 21.10.2026. Ergebnisinformationen sind fachliche Annahmen, keine ausführbaren Variablenzuweisungen. Alle drei Unterprozesse sind vollständig detailliert.</bpmn:documentation>
    <bpmn:startEvent id="E01" name="E01 Werkstattanfrage eingegangen">
      <bpmn:outgoing>F001</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ED_E01" messageRef="Msg_M01"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP1" name="SP1 K4.1 Auftrag und Leistungsumfang klären">
      <bpmn:documentation>Start mit Werkstattauftrag. Ergebnis AuftragFreigegeben: Ja nur nach G02 Freigegeben. A33 hält bei technischer Unmöglichkeit, Ablehnung oder Fristablauf AuftragFreigegeben=Nein und den Grund fest.</bpmn:documentation>
      <bpmn:incoming>F001</bpmn:incoming>
      <bpmn:outgoing>F002</bpmn:outgoing>
      <bpmn:laneSet id="LS_SP1">
        <bpmn:lane id="L_SP1_SA" name="Serviceannahme">
          <bpmn:flowNodeRef>E16</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A33</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_SP1_WT" name="Werkstatt">
          <bpmn:flowNodeRef>A03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="E16" name="E16 Auftrag beginnen">
        <bpmn:outgoing>F010</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="A01" name="A01 Anliegen und Kontaktdaten erfassen">
        <bpmn:incoming>F010</bpmn:incoming>
        <bpmn:outgoing>F011</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A02" name="A02 E-Bike und Übergabezustand erfassen">
        <bpmn:incoming>F011</bpmn:incoming>
        <bpmn:outgoing>F012</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A05" name="A05 Kosten und Terminrahmen schätzen">
        <bpmn:incoming>F015</bpmn:incoming>
        <bpmn:outgoing>F017</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sendTask id="A06" name="A06 Vorschlag zur Freigabe senden" messageRef="Msg_M02">
        <bpmn:incoming>F017</bpmn:incoming>
        <bpmn:outgoing>F018</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="A07" name="A07 Kundenentscheid empfangen" messageRef="Msg_M03">
        <bpmn:incoming>F018</bpmn:incoming>
        <bpmn:outgoing>F019</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="G02" name="G02 Kundenentscheid?" gatewayDirection="Diverging">
        <bpmn:incoming>F019</bpmn:incoming>
        <bpmn:outgoing>F020</bpmn:outgoing>
        <bpmn:outgoing>F021</bpmn:outgoing>
        <bpmn:outgoing>F023</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:boundaryEvent id="E03" name="E03 Antwortfrist erreicht" attachedToRef="A07" cancelActivity="true">
        <bpmn:outgoing>F024</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_E03">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">vereinbarteAntwortfrist_A07</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:task id="A33" name="A33 Abschlussart und Grund festhalten">
        <bpmn:documentation>Fortsetzbarkeit Nein und konkreten Grund festhalten; SP2 wird übersprungen.</bpmn:documentation>
        <bpmn:incoming>F016</bpmn:incoming>
        <bpmn:incoming>F023</bpmn:incoming>
        <bpmn:incoming>F024</bpmn:incoming>
        <bpmn:outgoing>F025</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E18" name="E18 Nicht fortsetzbar">
        <bpmn:incoming>F025</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="A03" name="A03 E-Bike diagnostizieren">
        <bpmn:incoming>F012</bpmn:incoming>
        <bpmn:incoming>F022</bpmn:incoming>
        <bpmn:outgoing>F013</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="G01" name="G01 Auftrag technisch machbar?" gatewayDirection="Diverging">
        <bpmn:incoming>F013</bpmn:incoming>
        <bpmn:outgoing>F014</bpmn:outgoing>
        <bpmn:outgoing>F016</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A04" name="A04 Leistungsumfang und Teilebedarf festlegen">
        <bpmn:incoming>F014</bpmn:incoming>
        <bpmn:outgoing>F015</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A08" name="A08 Änderungswunsch fachlich prüfen">
        <bpmn:incoming>F021</bpmn:incoming>
        <bpmn:outgoing>F022</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E17" name="E17 Freigabe liegt vor">
        <bpmn:incoming>F020</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F010" sourceRef="E16" targetRef="A01" name=""/>
      <bpmn:sequenceFlow id="F011" sourceRef="A01" targetRef="A02" name=""/>
      <bpmn:sequenceFlow id="F012" sourceRef="A02" targetRef="A03" name=""/>
      <bpmn:sequenceFlow id="F013" sourceRef="A03" targetRef="G01" name=""/>
      <bpmn:sequenceFlow id="F014" sourceRef="G01" targetRef="A04" name="Ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F015" sourceRef="A04" targetRef="A05" name=""/>
      <bpmn:sequenceFlow id="F016" sourceRef="G01" targetRef="A33" name="Nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nein</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F017" sourceRef="A05" targetRef="A06" name=""/>
      <bpmn:sequenceFlow id="F018" sourceRef="A06" targetRef="A07" name=""/>
      <bpmn:sequenceFlow id="F019" sourceRef="A07" targetRef="G02" name=""/>
      <bpmn:sequenceFlow id="F020" sourceRef="G02" targetRef="E17" name="Freigegeben">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Freigegeben</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F021" sourceRef="G02" targetRef="A08" name="Ändern">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ändern</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F022" sourceRef="A08" targetRef="A03" name=""/>
      <bpmn:sequenceFlow id="F023" sourceRef="G02" targetRef="A33" name="Abgelehnt">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Abgelehnt</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F024" sourceRef="E03" targetRef="A33" name=""/>
      <bpmn:sequenceFlow id="F025" sourceRef="A33" targetRef="E18" name=""/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP2" name="SP2 K4.2 Wartung / Reparatur planen und durchführen">
      <bpmn:documentation>Start nur bei Freigabe. Ergebnis ArbeitenPruefbereit: Ja nach Ausführung ohne offenen ergebnisrelevanten Zusatzbefund. A34 hält andernfalls ArbeitenPruefbereit=Nein und den Grund fest. E15/E14 bleiben innerhalb SP2.</bpmn:documentation>
      <bpmn:incoming>F003</bpmn:incoming>
      <bpmn:outgoing>F005</bpmn:outgoing>
      <bpmn:laneSet id="LS_SP2">
        <bpmn:lane id="L_SP2_SA" name="Serviceannahme">
          <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G05</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A17</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A18</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A34</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E21</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="L_SP2_WT" name="Werkstatt">
          <bpmn:flowNodeRef>E19</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A09</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G04</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G06</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G07</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A15</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>G08</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A16</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E20</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>A19</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>E15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="E19" name="E19 Freigegebenen Auftrag übernehmen">
        <bpmn:outgoing>F026</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="G03" name="G03 Ersatzteile erforderlich?" gatewayDirection="Mixed">
        <bpmn:incoming>F026</bpmn:incoming>
        <bpmn:incoming>F054</bpmn:incoming>
        <bpmn:outgoing>F027</bpmn:outgoing>
        <bpmn:outgoing>F031</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="A09" name="A09 Teilebereitstellung bei K2 anfordern" messageRef="Msg_M04">
        <bpmn:incoming>F027</bpmn:incoming>
        <bpmn:outgoing>F028</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="A10" name="A10 Statusmeldung von K2 empfangen" messageRef="Msg_M05">
        <bpmn:incoming>F028</bpmn:incoming>
        <bpmn:outgoing>F029</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="G04" name="G04 Teile bereit?" gatewayDirection="Diverging">
        <bpmn:incoming>F029</bpmn:incoming>
        <bpmn:outgoing>F030</bpmn:outgoing>
        <bpmn:outgoing>F032</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="E06" name="E06 Teile von K2 bereitgestellt">
        <bpmn:incoming>F035</bpmn:incoming>
        <bpmn:outgoing>F036</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ED_E06" messageRef="Msg_M08"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="G06" name="G06 Teilebereitstellung zusammenführen" gatewayDirection="Converging">
        <bpmn:incoming>F030</bpmn:incoming>
        <bpmn:incoming>F036</bpmn:incoming>
        <bpmn:outgoing>F037</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A13" name="A13 Teile und Auftrag abgleichen">
        <bpmn:incoming>F037</bpmn:incoming>
        <bpmn:outgoing>F038</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="E14" name="E14 Neu planen">
        <bpmn:outgoing>F054</bpmn:outgoing>
        <bpmn:linkEventDefinition id="LED_E14" name="Neu planen">
          <bpmn:source>LED_E15</bpmn:source>
        </bpmn:linkEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="G07" name="G07 Arbeitsplanung zusammenführen" gatewayDirection="Converging">
        <bpmn:incoming>F031</bpmn:incoming>
        <bpmn:incoming>F038</bpmn:incoming>
        <bpmn:outgoing>F044</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A14" name="A14 Werkstatttermin und Arbeit planen">
        <bpmn:incoming>F044</bpmn:incoming>
        <bpmn:outgoing>F045</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="A15" name="A15 Freigegebenen Arbeitsumfang bearbeiten">
        <bpmn:documentation>Nur aktuell freigegebenen offenen Umfang bearbeiten. Bei einem ergebnisrelevanten Befund die Arbeit am betroffenen Umfang anhalten; keine noch nicht freigegebene Zusatzarbeit durchführen.</bpmn:documentation>
        <bpmn:incoming>F045</bpmn:incoming>
        <bpmn:outgoing>F046</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="G08" name="G08 Ergebnisrelevanter Zusatzbefund ausserhalb Freigabe?" gatewayDirection="Diverging">
        <bpmn:documentation>Ja nur bei einem Befund ausserhalb der Freigabe, der das vereinbarte Ergebnis verhindert. Optionale Empfehlungen ohne Einfluss auf dieses Ergebnis folgen dem Nein-Weg und ändern den Auftrag nicht.</bpmn:documentation>
        <bpmn:incoming>F046</bpmn:incoming>
        <bpmn:outgoing>F047</bpmn:outgoing>
        <bpmn:outgoing>F048</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A16" name="A16 Zusatzbefund und Mehrbedarf dokumentieren">
        <bpmn:incoming>F048</bpmn:incoming>
        <bpmn:outgoing>F049</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E20" name="E20 Arbeiten zur Prüfung bereit">
        <bpmn:incoming>F047</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="A11" name="A11 Lieferoption zur Freigabe senden" messageRef="Msg_M06">
        <bpmn:incoming>F032</bpmn:incoming>
        <bpmn:outgoing>F033</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="A12" name="A12 Lieferentscheid empfangen" messageRef="Msg_M07">
        <bpmn:incoming>F033</bpmn:incoming>
        <bpmn:outgoing>F034</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="E05" name="E05 Antwortfrist erreicht" attachedToRef="A12" cancelActivity="true">
        <bpmn:outgoing>F040</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_E05">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">vereinbarteAntwortfrist_A12</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G05" name="G05 Lieferoption akzeptiert?" gatewayDirection="Diverging">
        <bpmn:incoming>F034</bpmn:incoming>
        <bpmn:outgoing>F035</bpmn:outgoing>
        <bpmn:outgoing>F039</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="A17" name="A17 Ergänzung zur Freigabe senden" messageRef="Msg_M09">
        <bpmn:incoming>F049</bpmn:incoming>
        <bpmn:outgoing>F050</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="A18" name="A18 Zusatzentscheid empfangen" messageRef="Msg_M10">
        <bpmn:incoming>F050</bpmn:incoming>
        <bpmn:outgoing>F051</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:boundaryEvent id="E08" name="E08 Antwortfrist erreicht" attachedToRef="A18" cancelActivity="true">
        <bpmn:outgoing>F042</bpmn:outgoing>
        <bpmn:timerEventDefinition id="ED_E08">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">vereinbarteAntwortfrist_A18</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="G09" name="G09 Zusatzumfang freigegeben?" gatewayDirection="Diverging">
        <bpmn:incoming>F051</bpmn:incoming>
        <bpmn:outgoing>F041</bpmn:outgoing>
        <bpmn:outgoing>F052</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="A19" name="A19 Auftrag und Freigabe aktualisieren">
        <bpmn:incoming>F052</bpmn:incoming>
        <bpmn:outgoing>F053</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="E15" name="E15 Neu planen">
        <bpmn:incoming>F053</bpmn:incoming>
        <bpmn:linkEventDefinition id="LED_E15" name="Neu planen">
          <bpmn:target>LED_E14</bpmn:target>
        </bpmn:linkEventDefinition>
      </bpmn:intermediateThrowEvent>
      <bpmn:task id="A34" name="A34 Abschlussart und Grund festhalten">
        <bpmn:documentation>ArbeitenPruefbereit Nein und konkreten Grund festhalten; G14 wählt die Zustandsdokumentation.</bpmn:documentation>
        <bpmn:incoming>F039</bpmn:incoming>
        <bpmn:incoming>F040</bpmn:incoming>
        <bpmn:incoming>F041</bpmn:incoming>
        <bpmn:incoming>F042</bpmn:incoming>
        <bpmn:outgoing>F043</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E21" name="E21 Nicht fortsetzbar">
        <bpmn:incoming>F043</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F026" sourceRef="E19" targetRef="G03" name=""/>
      <bpmn:sequenceFlow id="F027" sourceRef="G03" targetRef="A09" name="Ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F028" sourceRef="A09" targetRef="A10" name=""/>
      <bpmn:sequenceFlow id="F029" sourceRef="A10" targetRef="G04" name=""/>
      <bpmn:sequenceFlow id="F030" sourceRef="G04" targetRef="G06" name="Ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F031" sourceRef="G03" targetRef="G07" name="Nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nein</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F032" sourceRef="G04" targetRef="A11" name="Nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nein</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F033" sourceRef="A11" targetRef="A12" name=""/>
      <bpmn:sequenceFlow id="F034" sourceRef="A12" targetRef="G05" name=""/>
      <bpmn:sequenceFlow id="F035" sourceRef="G05" targetRef="E06" name="Ja">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F036" sourceRef="E06" targetRef="G06" name=""/>
      <bpmn:sequenceFlow id="F037" sourceRef="G06" targetRef="A13" name=""/>
      <bpmn:sequenceFlow id="F038" sourceRef="A13" targetRef="G07" name=""/>
      <bpmn:sequenceFlow id="F039" sourceRef="G05" targetRef="A34" name="Nein">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nein</bpmn:conditionExpression>
